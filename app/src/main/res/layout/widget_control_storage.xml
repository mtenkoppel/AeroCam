<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetControlStorageGroup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/widgetControlStorageIcon"
        android:layout_width="@dimen/widget_control_status_icon"
        android:layout_height="@dimen/widget_control_status_icon"
        android:contentDescription="@string/widget_storage"
        android:src="@drawable/ic_widget_storage" />
    <TextView
        android:id="@+id/widgetControlStorage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="@dimen/widget_control_status_text"
        android:textColor="@color/dji_text_primary_dark" />
</LinearLayout>
