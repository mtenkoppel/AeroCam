<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_root_dark" android:clipToOutline="true">
    <TextView android:id="@+id/widgetFieldCaption" android:layout_width="match_parent"
        android:layout_height="@dimen/widget_field_caption_height" android:paddingStart="10px" android:paddingEnd="10px"
        android:gravity="center_vertical|left" android:maxLines="1" android:ellipsize="end"
        android:textSize="@dimen/widget_field_caption_text" android:textColor="@color/dji_text_primary_dark" />
    <FrameLayout android:id="@+id/widgetFieldBody" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
