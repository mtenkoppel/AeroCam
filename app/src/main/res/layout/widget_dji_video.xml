<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetVideoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_root_dark"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widgetVideoPrimary"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_surface_selector">

        <LinearLayout
            android:id="@+id/widgetVideoIdle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetVideoIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/widget_video"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_video" />

            <TextView
                android:id="@+id/widgetVideoIdleMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="4K 30FPS"
                android:textColor="@color/dji_text_primary_dark"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetVideoStatus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_searching"
            android:textAlignment="center"
            android:textColor="@color/dji_text_primary_dark"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/widgetVideoRecording"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widgetVideoTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="14:45"
                android:textColor="@color/dji_text_on_accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetVideoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="14.5 GB  4K 30FPS"
                android:textColor="@color/dji_text_on_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widgetVideoSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/dji_icon_primary"
            android:indeterminateTintMode="src_in"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widgetVideoHighlight"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_surface_selector">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_add_highlight"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_highlight" />
    </FrameLayout>
</LinearLayout>
